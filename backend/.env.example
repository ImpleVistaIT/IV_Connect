# Copy this file to .env and fill in your real values.
# .env is gitignored on purpose - never commit real credentials.

PORT=4000
NODE_ENV=development

# --- Database connection ---
# For your local Docker SQL Server, these match what you used in `docker run`.
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=IVConnect
DB_USER=sa
DB_PASSWORD=YourStrong!Passw0rd

# Set to true for local dev only (self-signed certificate).
# Set to false once connecting to a real server with a proper certificate.
DB_TRUST_SERVER_CERTIFICATE=true
